# Öffentliche Adresse (ohne / am Ende). Wird in Einladungslinks und QR-Codes verwendet.
BASE_URL=https://hochzeit.example.de
# Nur für docker-compose/Caddy: Domain für das HTTPS-Zertifikat
DOMAIN=hochzeit.example.de

PORT=3000
DATA_DIR=/data
TZ=Europe/Berlin

# Paket für neue Hochzeiten: premium (Selbsthoster, alle Funktionen) oder free (Freemium-Betrieb)
DEFAULT_PLAN=premium
# Passwort für die Betreiber-Konsole unter /betreiber (leer = deaktiviert)
OPERATOR_PASSWORD=

# Grenzen
MAX_PHOTO_MB=15
MAX_VIDEO_MB=80
FREE_PLAN_PHOTOS=100
FREE_PLAN_GUESTS=60

# E-Mail-Versand von Einladungen (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ringo <hochzeit@example.de>"

# KI-Funktionen: Gästefragen-Assistent & Rede-Helfer (optional, Claude API)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
